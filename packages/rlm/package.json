{
  "name": "@yellowbee686/dsh-rlm",
  "version": "0.1.0",
  "description": "Headless composition of the upstream Prime persistent TypeScript REPL for DSH",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.mjs",
    "./runtime": "./runtime.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.mjs",
    "schema-presentation.mjs",
    "read-text.mjs",
    "runtime.mjs",
    "tool-restrictions.mjs",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "vendor"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    }
  },
  "dependencies": {
    "dsh-prime-agent": "file:vendor/dsh-prime-agent-0.6.3.tgz"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.1.7-rc.2 || >=0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.2 || >=0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.7-rc.2 || >=0.2.0-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yellowbee686/agent-harness-plugin.git",
    "directory": "packages/rlm"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "rlm"
  ]
}
